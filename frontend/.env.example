# El frontend NO necesita ninguna clave de Stripe.
#
# En desarrollo, Vite redirige /api al backend (ver vite.config.ts), así que
# normalmente no hace falta configurar nada aquí.
#
# Solo si despliegas el frontend en un dominio distinto al del backend,
# descomenta y apunta a la URL pública de la API:
# VITE_API_URL=https://api.tu-dominio.com/api

# NUNCA pongas STRIPE_SECRET_KEY aquí: todo lo que empieza por VITE_ se
# incrusta en el bundle y queda visible para cualquiera.
