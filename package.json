{
  "name": "stripe-subscription-coupon-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "MVP: suscripción mensual en Stripe con descuento automático durante 12 meses",
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "setup:stripe": "npm run setup:stripe --prefix backend",
    "verify": "npm run verify --prefix backend",
    "verify:testclock": "npm run verify:testclock --prefix backend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
