# ---------------------------------------------------------------------------
# Stripe MVP — suscripción mensual con descuento de 12 meses
# ---------------------------------------------------------------------------
# Copia este archivo a `backend/.env` y rellena los valores desde tu Dashboard
# de Stripe EN MODO TEST (https://dashboard.stripe.com/test/apikeys).
#
# NUNCA subas el archivo .env real al repositorio. Aquí no hay secretos reales.
# ---------------------------------------------------------------------------

# Clave secreta. SOLO backend. Nunca se envía al navegador. Empieza con sk_test_
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clave publicable. Es pública por diseño; puede exponerse al frontend.
# Este MVP usa Stripe Checkout (redirección), así que no es obligatoria,
# pero se incluye porque la pediste y la necesitarás si algún día pasas a
# Stripe Elements. Empieza con pk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de firma del webhook. Lo imprime `stripe listen` (whsec_...).
# Sin esto el endpoint de webhooks rechaza todos los eventos.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID del precio mensual recurrente ($1,000.00 MXN / mes). Empieza con price_
# El backend SIEMPRE usa este ID; el precio jamás se acepta desde React.
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URLs de la aplicación
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Puerto del backend (debe coincidir con BACKEND_URL)
PORT=3000
